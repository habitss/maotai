# 是否启用mock
VITE_USE_MOCK = true

# 项目区分
VITE_GROUP = mes3

#进入系统后左上角文字
VITE_GLOB_APP_SHORT_NAME = '茅台B园区数字化平台'

#进入页面提示文字
VITE_GLOB_APP_TITLE = 茅台B园区数字化平台

# 发布路径
