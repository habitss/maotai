<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.keytech.modules.kpi.mapper.KpiTypeMapper">

    <select id="queryListByPid" parameterType="java.lang.Object" resultType="org.jeecg.common.system.vo.SelectTreeModel">
        select
        id as "key",
        kpi_type as "title",
        (case when has_child = '1' then 0 else 1 end) as isLeaf,
        parent_id as parentId
        from mes3_kpi_type
        where parent_id = #{parentId} and del_flag = '0'
        <if test="query != null">
            <foreach collection="query.entrySet()" item="value" index="key">
                and ${key} = #{value}
            </foreach>
        </if>
    </select>

    <select id="deptList" resultType="com.keytech.modules.kpi.dto.DepartDto">
        select * from sys_depart where del_flag = 0
        <if test="isRoot != null and isRoot !='' "> and org_type > 2 </if>
        order by org_type
    </select>
</mapper>