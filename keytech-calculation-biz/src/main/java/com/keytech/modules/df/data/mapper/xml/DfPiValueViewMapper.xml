<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.keytech.modules.df.data.mapper.DfPiValueViewMapper">

    <select id="selectList" resultType="com.keytech.modules.df.data.vo.DfPiValueView">
        SELECT * FROM df_pi_value_view
        <where>
            <if test="startTime != null">
                AND UpdateTime <![CDATA[ >= ]]> #{startTime}
            </if>
            <if test="endTime != null">
                AND UpdateTime <![CDATA[ < ]]> #{endTime}
            </if>
        </where>
    </select>

</mapper>