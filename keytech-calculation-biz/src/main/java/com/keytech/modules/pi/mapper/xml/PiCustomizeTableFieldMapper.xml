<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.keytech.modules.pi.mapper.PiCustomizeTableFieldMapper">
    <!--表新增字段-->
    <update id="addTableField" parameterType="com.keytech.modules.pi.entity.PiCustomizeTableField">
        ALTER TABLE ${tableName} ADD COLUMN ${fieldName}
            ${fieldType}
            <if test="type != null and type == 1">
                (${fieldLength})
                <if test=" _databaseId == 'mysql'">
                    CHARACTER set utf8mb4 collate utf8mb4_general_ci
                </if>
            </if>
            DEFAULT NULL
            <!--COMMENT #{name}-->
    </update>

    <!--获取自定义报表下所有字段-->
    <select id="getFieldByTableId" resultType="com.keytech.modules.pi.entity.PiCustomizeTableField">
        SELECT * FROM mes3_pi_customize_table_field where table_id = #{tableId}
    </select>

    <!--创建视图-->
    <update id="view" >
        CREATE OR REPLACE VIEW ${viewName} AS
        select * from ${viewTables} where ${viewConditions}
    </update>

    <!--同步数据-->
    <insert id="synchronizeData" >
        insert into ${subtable} (${field})
        select id from ${tableName}
    </insert>

    <!--创建索引-->
    <update id="createIndex">
        <if test="_databaseId == 'postgresql'">
            CREATE INDEX ${idxName}
            ON ${tableName} (${fields})
        </if>
        <if test="_databaseId == 'mysql'">
            ALTER TABLE ${tableName}
            ADD INDEX idx_tenant_time_query (${fields});
        </if>
    </update>

    <!--删除索引-->
    <update id="deleteIndex" >
        <if test="_databaseId == 'postgresql'">
            DROP INDEX IF EXISTS ${idxName}
        </if>
        <if test="_databaseId == 'mysql'">
            DROP INDEX idx_tenant_time_query ON ${tableName};
        </if>
    </update>

    <!--删除索引-->
    <select id="selectIndex" resultType="java.lang.Integer">
        <if test="_databaseId == 'postgresql'">
            SELECT COUNT(*)
            FROM pg_index i
            JOIN pg_class c ON c.oid = i.indrelid
            JOIN pg_class ic ON ic.oid = i.indexrelid
            JOIN pg_namespace n ON n.oid = c.relnamespace
            WHERE n.nspname = current_schema()
            AND c.relname = #{tableName}
            AND ic.relname = #{idxName}
        </if>
        <if test="_databaseId == 'mysql'">
            SELECT COUNT(*) FROM information_schema.statistics
            WHERE table_schema = DATABASE()
            AND table_name = #{tableName}
            AND index_name = 'idx_tenant_time_query'
        </if>
    </select>
</mapper>