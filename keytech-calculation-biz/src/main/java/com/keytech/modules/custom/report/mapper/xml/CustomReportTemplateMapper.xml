<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.keytech.modules.custom.report.mapper.CustomReportTemplateMapper">

    <resultMap id="BaseResultMap" type="com.keytech.modules.custom.report.entity.CustomReportTemplateEntity">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="tenantId" column="tenant_id" jdbcType="INTEGER"/>
            <result property="factoryCode" column="factory_code" jdbcType="VARCHAR"/>
            <result property="deptCode" column="dept_code" jdbcType="VARCHAR"/>
            <result property="lineCode" column="line_code" jdbcType="VARCHAR"/>
            <result property="reportName" column="report_name" jdbcType="VARCHAR"/>
            <result property="tableId" column="table_id" jdbcType="BIGINT"/>
            <result property="tableName" column="table_name" jdbcType="VARCHAR"/>
            <result property="reportConfig" column="report_config" jdbcType="VARCHAR"/>
            <result property="sort" column="sort" jdbcType="INTEGER"/>
            <result property="delFlag" column="del_flag" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,tenant_id,factory_code,
        dept_code,line_code,report_name,
        table_id,table_name,report_config,
        sort,del_flag,create_time,
        update_time,create_by,update_by,
        remark
    </sql>

    <select id="getUserAll">
        select id, username, realname from sys_user
        where username is not null
    </select>

    <select id="queryDataBySql">
        ${sql}
    </select>
    <select id="queryDoubleBySql" resultType="java.lang.Double">
        ${sql}
    </select>
</mapper>
